;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sprocket Conversion Tool 0.4+"
config/version="0.5.0"
config/tags=PackedStringArray("master")
run/main_scene="res://Scenes/Converter.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"
config/windows_native_icon="res://logo.ico"

[autoload]

FormatRegistry="*res://MeshFramework/Singleton/FormatRegistry.gd"
Debug="*res://Script/Utilities/Debug.gd"
ErrorHandler="*res://Script/Utilities/Error.gd"
ConfigManager="*res://Script/Utilities/ConfigManager.gd"

[display]

window/size/viewport_width=780
window/size/viewport_height=700
window/subwindows/embed_subwindows=false

[editor_plugins]

enabled=PackedStringArray()

[global_group]

Lighting=""
OmniLight=""
Spotlight=""

